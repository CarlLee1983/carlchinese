{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlchinese",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "carlchinese.gravito.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
