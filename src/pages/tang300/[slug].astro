---
import { loadWorks } from '../../content/works.mjs';

export async function getStaticPaths() {
  const works = await loadWorks();
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
const { title, author, dynasty, text } = work.frontmatter;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜CarlChinese</title>
    <style>
      :root { color: #241f1a; background: #f7f5f0; font-family: ui-serif, "Noto Serif TC", serif; }
      body { max-width: 42rem; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
      h1 { font-size: clamp(2.3rem, 7vw, 3.5rem); margin-bottom: .25rem; }
      .byline { color: #665c50; margin-bottom: 3rem; }
      .poem { font-size: clamp(1.35rem, 4vw, 1.7rem); line-height: 2.2; letter-spacing: .08em; }
      .poem p { margin: 0; }
      .punctuation { color: #665c50; font-size: .95rem; margin-top: 2rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p class="byline">{author}・{dynasty}</p>
      <section aria-label="原文" class="poem">
        {text.map((line) => <p data-poem-line>{line}</p>)}
      </section>
      <p class="punctuation">標點為本站編輯所加</p>
    </main>
  </body>
</html>
