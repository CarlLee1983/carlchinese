  "dependencies": {
    "astro": "7.3.8",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  }
}
